# Dipakai docker-compose.yml saat BUILD image frontend.
# Salin jadi .env di folder ini sebelum `docker compose up -d --build`.
#
# Nilai-nilai ini ikut dibakar ke bundle browser, jadi mengubahnya berarti
# rebuild: `docker compose up -d --build web`.

# Domain publik tempat nginx melayani frontend dan API di origin yang sama.
NEXT_PUBLIC_API_URL=https://jelantara.iitech.id

# Sama persis dengan SUPABASE_URL / anon key di backend/.env, supaya token
# yang diterbitkan frontend adalah token yang diverifikasi authMiddleware.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
